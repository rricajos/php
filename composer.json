{
    "name": "rricajos/php",
    "description": "In-depth PHP 8.3 study — 334 practical examples across 26 categories",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricard Penin Honrubia",
            "homepage": "https://github.com/rricajos"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MiniProject\\": "mini_project/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php lint.php"
    },
    "config": {
        "sort-packages": true
    }
}
